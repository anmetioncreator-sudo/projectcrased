generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Key {
  id        String    @id @default(cuid())
  key       String    @unique
  owner     String
  scriptId  String
  lockedIp  String?
  banned    Boolean   @default(false)
  banReason String?
  expires   DateTime?
  createdAt DateTime  @default(now())
}

model BannedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String
  createdAt DateTime @default(now())
}

model AccessLog {
  id        String   @id @default(cuid())
  ip        String
  key       String
  result    String
  reason    String
  createdAt DateTime @default(now())
}

model Script {
  id        String   @id @default(cuid())
  scriptId  String   @unique
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
